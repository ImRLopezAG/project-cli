{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["ANDROID_HOME", "PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "prebuild": {
      "cache": false,
      "outputs": ["android/**", "ios/**"]
    },
    "clean": {
			"cache": false
		},
    "db:push": {
      "dependsOn": ["^db:push"]
    },
    "db:studio": {
      "dependsOn": ["^db:studio"]
    },
    "db:generate": {
      "dependsOn": ["^db:generate"]
    },
    "db:migrate": {
      "dependsOn": ["^db:migrate"]
    }
  }
}

