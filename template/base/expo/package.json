{
  "name": "queue-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "$npm_execpath clean:workspaces && git clean -xdf node_modules .turbo",
    "clean:workspaces": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "db:studio": "turbo run db:studio",
    "db:push": "turbo run db:push",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "typescript": "5.9.2",
    "zod": "4.1.12",
    "superjson": "2.2.2"
  },
  "catalogs": {
    "react19": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native": "0.81.4",
      "@types/react": "19.1.10"
    },
    "better-auth": {
      "better-auth": "1.3.27",
      "@better-auth/expo": "1.3.27"
    },
    "trpc": {
      "@trpc/server": "11.6.0",
      "@trpc/client": "11.6.0",
      "@trpc/tanstack-react-query": "11.6.0",
      "@tanstack/react-query": "5.90.3"
    }
  }
}